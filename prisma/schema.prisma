// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  FACEBOOK
}

model User {
  id         String       @id @default(uuid())
  email      String       @unique
  name       String?
  password   String? // Nullable because Google users may not have a local password.
  hashedRt   String?
  provider   AuthProvider @default(LOCAL)
  providerId String?
  profile    Profile?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([provider, providerId], name: "users_provider_providerId_key")
  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  bio       String?  @db.Text
  phone     String?
  avatarUrl String?
  address   String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model CompanyProfile {
  id          String   @id @default(uuid())
  brand       String
  quotes      String
  description String
  detail      String
  file        String?
  createdAt   DateTime @default(now())
  updateAt    DateTime @updatedAt

  @@map("companyprofile")
}

model Product {
  id          String   @id @default(uuid())
  title       String
  price       Decimal  @db.Decimal(10, 2)
  unit_price  String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model File {
  id        String   @id @default(uuid())
  title     String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Generic relation fields
  table_name String // e.g., "Product", "User", "Category"
  table_id   String // ID of the related record in table_name

  @@map("files")
}

model News {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  news        String   @db.Text
  file        String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Contact {
  id        String   @id @default(uuid())
  storeName String
  address   String   @db.Text
  phone     String
  email     String?
  mapsUrl   String?  @db.Text
  openHours String?
  instagram String?
  facebook  String?
  tiktok    String?
  tokopedia String?
  shopee    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}
